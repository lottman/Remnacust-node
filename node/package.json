{
  "name": "@remnacust/node",
  "version": "1.1.28",
  "private": false,
  "description": "Remnacust Node",
  "homepage": "https://github.com/lottman/Remnacust-node",
  "bugs": {
    "url": "https://github.com/lottman/Remnacust-node/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "REMNAWAVE <github.com/remnawave>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lottman/Remnacust-node.git",
    "directory": "node"
  },
  "bin": {
    "cli": "dist/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "rspack build",
    "dev": "NODE_ENV=development rspack --watch --mode development",
    "start": "node dist/main.js",
    "trace": "node scripts/trace.mjs",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "fix": "oxfmt && oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@henrygd/semaphore": "0.1.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/cqrs": "12.1.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/schedule": "12.0.3",
    "@remnawave/hashed-set": "^0.0.4",
    "@remnawave/node-plugins": "0.8.3",
    "@remnawave/xtls-sdk": "0.17.0",
    "@remnawave/xtls-sdk-nestjs": "0.6.1",
    "body-parser": "2.4.0",
    "compression": "^1.8.2",
    "consola": "^3.4.2",
    "enhanced-ms": "5.0.0",
    "helmet": "^8.3.0",
    "json-colorizer": "^3.0.1",
    "lmdb": "3.5.9",
    "morgan": "1.12.1",
    "nest-winston": "2.0.0",
    "nestjs-zod": "5.6.0",
    "nftables-napi": "0.7.1",
    "nice-grpc": "2.1.18",
    "node-object-hash": "^3.1.1",
    "object-hash": "^3.0.0",
    "p-map": "7.1.1",
    "p-retry": "9.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pretty-bytes": "7.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "semver": "7.8.6",
    "sockdestroy": "2.0.1",
    "winston": "^3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@rspack/cli": "2.3.1",
    "@rspack/core": "2.3.1",
    "@rspack/dev-server": "2.2.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "26.6.6",
    "@types/object-hash": "^3.0.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/semver": "^7.8.0",
    "nf3": "0.4.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "run-script-webpack-plugin": "^0.2.3",
    "ts-checker-rspack-plugin": "1.7.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "webpack-node-externals": "^3.0.0",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "multer": "2.5.0",
    "zod": "$zod",
    "@grpc/grpc-js": "1.14.5",
    "proxy-addr": "2.0.8",
    "tinypool": "2.1.2",
    "ts-checker-rspack-plugin": {
      "chokidar": "4.0.3"
    },
    "nestjs-zod": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/core": "$@nestjs/core"
    }
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
