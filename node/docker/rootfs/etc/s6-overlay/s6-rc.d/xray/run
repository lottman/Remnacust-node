#!/command/with-contenv sh

exec 2>&1
node /etc/s6-overlay/scripts/core-boot.cjs
selection_status=$?
case "$selection_status" in
    0) ;;
    75) exec /command/s6-pause ;;
    *) exit "$selection_status" ;;
esac
if grep -aq 'remnacust-live-ports-v1' /usr/local/bin/rw-core; then
    exec /usr/local/bin/rw-core \
        -runtime-cache /var/lib/remnacust/run/core-state/checkpoint.pb \
        -config "${INTERNAL_SOCKET_PATH}":/internal/get-config?token="${INTERNAL_REST_TOKEN}" \
        -format json
fi
exec /usr/local/bin/rw-core \
    -config "${INTERNAL_SOCKET_PATH}":/internal/get-config?token="${INTERNAL_REST_TOKEN}" \
    -format json
